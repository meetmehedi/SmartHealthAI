        "name": "UCI Heart Disease Dataset (Cleaned - GitHub Mirror)",
        "url": "https://raw.githubusercontent.com/sharmaroshan/Heart-UCI-Dataset/master/heart.csv",
        "records_used": 50,
        "note": "Cleaned version of UCI dataset with named columns: age, sex, cp (chest pain type), trestbps (resting BP), chol, thalach (max HR), target (0=no disease, 1=disease)"
      },
      {
        "name": "WHO & AHA Clinical Reference Ranges",
        "url": "https://www.heart.org/en/health-topics/high-blood-pressure/understanding-blood-pressure-readings",
        "note": "Normal ranges for SpO2 and Temperature from WHO Pulse Oximetry guidelines and standard clinical references"
      }
    ],
    "columns_description": {
      "id": "Record identifier",
      "source_id": "Original ID in source dataset",
      "age": "Patient age in years",
      "sex": "Patient gender (Male/Female)",
      "resting_bp": "Resting blood pressure in mmHg (trestbps in UCI)",
      "max_heart_rate": "Maximum heart rate achieved during exercise test (thalach in UCI)",
      "resting_heart_rate_estimated": "Estimated resting HR derived from max HR (max_HR * 0.50 ± variation)",
      "spo2_estimated": "Estimated SpO2 (%) - assigned based on clinical profile",
      "temperature_estimated": "Estimated body temperature (°C) - assigned based on clinical profile",
      "chest_pain_type": "Type of chest pain: Typical Angina / Atypical Angina / Non-Anginal / Asymptomatic",
      "exercise_angina": "Exercise-induced angina: Yes/No",
      "fasting_blood_sugar_high": "Fasting blood sugar > 120 mg/dl: Yes/No",
      "st_depression": "ST depression induced by exercise relative to rest",
      "heart_disease": "Heart disease diagnosis: Yes/No (target in UCI: 0=No, ≥1=Yes)",
      "ai_expected_status": "Expected AI system output status: Healthy / Warning / Critical",
      "clinical_notes": "Brief clinical interpretation"
    },
    "ai_classification_rules": {
      "Healthy":  "Resting HR 60-100, SpO2 ≥95%, Temp 36.1-37.2°C, BP 90-120 mmHg",
      "Warning":  "One or more vitals mildly outside normal range (HR 40-59 or 101-130, SpO2 91-94%, Temp 35.0-36.0 or 37.3-39.0°C, BP 70-89 or 121-159 mmHg)",
      "Critical": "Any vital severely out of range (HR <40 or >130, SpO2 <91%, Temp <35.0 or >39.0°C, BP <70 or ≥160 mmHg)"
    },
    "total_records": 50,
    "categories": { "Healthy": 18, "Warning": 22, "Critical": 10 }
  },
